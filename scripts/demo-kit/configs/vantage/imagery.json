{
  "about": "Vantage device imagery for the demo kit, and since part b (2026-10-01) the source: scripts/fetch-vantage-devices.mjs is a thin wrapper over scripts/demo-kit/fetch-imagery.mjs with this section. The URL list, the makers’ licence notes and the two view sentences were transcribed from that script (its DEVICES and LICENCE, commit c720907) and match public/vantage/img/MANIFEST.json; `gate` is its GATE, the human defect-check verdict per device, each bound to the sha256 of the exact file reviewed (a changed byte reads pending until someone looks again). Rendered at 800 square, 86 % fill, the kit’s defaults, which are Vantage’s own.",
  "dir": "public/vantage/img",
  "manifest": "public/vantage/img/MANIFEST.json",
  "section": "devices",
  "subdir": "devices",
  "cacheName": "vantage-device-cache",
  "budgetMegabytes": 25,
  "placeholder": {
    "key": "device",
    "file": "placeholder-device.svg"
  },
  "manifestAbout": "Provenance and the human defect-check verdict for every image under public/vantage/img/. Devices are written by scripts/fetch-vantage-devices.mjs; promos, heroes, plans, modules and placeholders by scripts/generate-vantage-art.mjs. A verdict holds only for the sha256 it was given to; a changed file reads pending. No image carries a carrier mark; the makers' own marks on their devices are part of the product.",
  "views": {
    "pair": "maker's own back-and-front render",
    "compose": "back and front renders, placed as a pair"
  },
  "render": {
    "size": 800,
    "fill": 0.86
  },
  "licences": {
    "apple": "Official product render published by Apple on apple.com (Apple Store buy page). © Apple Inc.; iPhone and Apple are Apple trademarks. No licence is granted by the page; used only to identify the product in an internal demo. Crop, scale and ground only.",
    "samsung": "Official product render published by Samsung on samsung.com/us (unlocked SKU, so no carrier variant). © Samsung Electronics; Galaxy is a Samsung trademark. No licence is granted by the page; used only to identify the product in an internal demo. Crop, scale and ground only.",
    "google": "Official product renders published by Google on the Google Store (store.google.com, unlocked SKU). © Google LLC; Pixel is a Google trademark. No licence is granted by the page; used only to identify the product in an internal demo. The back and front renders are placed as a pair by this script; each render is unmodified apart from scale and ground.",
    "motorola": "Official press-box image from Motorola News (motorolanews.com/pressbox, Motorola's own newsroom, \"All rights reserved\"). © Motorola Mobility LLC; razr and moto are Motorola trademarks. Press-box images are published for media use; used only to identify the product in an internal demo. Crop, scale and ground only."
  },
