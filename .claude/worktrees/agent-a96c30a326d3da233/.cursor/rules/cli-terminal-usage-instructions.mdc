## 🔧 Advanced Techniques

### Technique 1: Safe JSON Testing
```powershell
@'
const testQuery = {
  "structured_query": {
    "from": "flags_unified_view",
    "select": ["flag_key", "enabled", "environment_key"],
    "limit": 5
  }
};

console.log('Testing with JSON query:');
console.log(JSON.stringify(testQuery, null, 2));

// Test the CLI with this query
const { execSync } = require('child_process');
const jsonStr = JSON.stringify(testQuery).replace(/"/g, '\\"');
const cmd = `node ./bin/optly analytics analyze --query "${jsonStr}"`;

try {
  const result = execSync(cmd, { encoding: 'utf8', timeout: 15000 });
  console.log('Query result:', result);
} catch (error) {
  console.log('Query failed:', error.message);
}
'@ | node
```

### Technique 2: Timeout and Error Handling
```powershell
@'
const { spawn } = require('child_process');

function testWithTimeout(command, args, timeoutMs = 10000) {
  return new Promise((resolve, reject) => {
    const child = spawn(command, args, { shell: true });
    let stdout = '';
    let stderr = '';
    
    const timer = setTimeout(() => {
      child.kill();
      reject(new Error(`Command timed out after ${timeoutMs}ms`));
    }, timeoutMs);
    
    child.stdout.on('data', (data) => {
      stdout += data;
    });
    
    child.stderr.on('data', (data) => {
      stderr += data;
    });
    
    child.on('close', (code) => {
      clearTimeout(timer);
      resolve({ code, stdout, stderr });
    });
  });
}

async function runTests() {
  const tests = [
    ['node', ['./bin/optly', 'health']],
    ['node', ['./bin/optly', 'sync', 'status']],
    ['node', ['./bin/optly', 'analytics', 'templates']]
  ];
  
  for (const [cmd, args] of tests) {
    try {
      console.log(`Testing: ${cmd} ${args.join(' ')}`);
      const result = await testWithTimeout(cmd, args, 15000);
      console.log(`✅ Exit code: ${result.code}`);
      if (result.stdout) console.log('Output:', result.stdout.substring(0, 200));
    } catch (error) {
      console.log(`❌ Error: ${error.message}`);
    }
  }
}

runTests();
'@ | node
```

