# Development Configuration
# Copy this file to .env.local for local development overrides

# Development server will run on port 9100
# You can access the API at: http://localhost:9100

# Example environment variables (these are set in wrangler.toml for development)
# JWT_SECRET=development-secret-key-change-in-production
# JWT_ISSUER=edge-platform
# JWT_AUDIENCE=edge-platform-api
# OPTIMIZELY_SDK_KEY=your-sdk-key-here
# OPTIMIZELY_DATAFILE_URL=https://cdn.optimizely.com/datafiles/your-datafile.json

# For production deployment, use wrangler secrets:
# wrangler secret put JWT_SECRET
# wrangler secret put OPTIMIZELY_SDK_KEY
# wrangler secret put API_KEYS
# wrangler secret put WEBHOOK_ENDPOINTS
# wrangler secret put CDP_ENDPOINTS