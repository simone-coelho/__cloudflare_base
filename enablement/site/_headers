# Response headers for every address on the internal enablement site.
# Workers static assets read this file when the site is deployed; the file itself is never served.
# Check it before every deploy:  node enablement/check-site.mjs
#
# The Content-Security-Policy allows nothing except the inline style each page carries, named by its
# SHA-256 (never unsafe-inline), and the inline icon. After editing the CSS in a page, run
#   node enablement/check-site.mjs --hashes
# and paste its style-src value into the policy below. A stale hash leaves the page unstyled and the
# browser console reports that it refused to apply the inline style.
/*
  Content-Security-Policy: default-src 'none'; style-src 'sha256-F6R0q2n/1TfqeKlCaZDEnovWp0bG3RcZ1R/kKNwiKRU=' 'sha256-LRgjqgMTPuMOlIMph0nB0RLZCWCUAAVXNVuSTjM/u7w='; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive
