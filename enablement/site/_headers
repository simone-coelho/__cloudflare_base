# Response headers for every address on the internal enablement site.
# The assets binding applies this file to every page the gate (enablement/worker.mjs) serves; the file
# itself is never served. Check it before every deploy:  node enablement/check-site.mjs
#
# The Content-Security-Policy lets a page load its stylesheet and its script from this site only
# (/site.css and /site.js, as 'self'), images only as inline data: URIs (the tab icon), and nothing else:
# no inline script, no other address, and no inline style unless named here by its SHA-256 (never
# unsafe-inline). One page still carries an inline style: E0's 404.html, allowed by the single hash beside
# 'self'. When that style moves to /site.css, delete the hash; the preflight fails until you do, and
#   node enablement/check-site.mjs --hashes
# prints the style-src value the pages need.
/*
  Content-Security-Policy: default-src 'none'; style-src 'self' 'sha256-F6R0q2n/1TfqeKlCaZDEnovWp0bG3RcZ1R/kKNwiKRU='; script-src 'self'; img-src data:; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  Cache-Control: private, no-store
  X-Robots-Tag: noindex, nofollow, noarchive
