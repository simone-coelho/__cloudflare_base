{
 "about": "Vantage is a fictional carrier; the phones are real, by their current US model names and prices. This file is catalog CONTENT: the engine never decides a price, a monthly figure or a trade-in value, and the page never ranks. The 'Phones for you' rail is ordered by POST /sort over this list in this order, and an affinity weight of zero reproduces this order exactly.",
 "asOf": "2026-09-30",
 "priceRule": "The carrier full retail price listed on verizon.com/smartphones (seen 2026-09-30) where the phone appears there; otherwise the maker's US list price, written the way a carrier lists it (.99). Storage steps only where a source gives them.",
 "sources": {
  "carrier-grid": "https://www.verizon.com/smartphones/ (seen 2026-09-30; grid page 1, default SKU)",
  "carrier-pdp": "https://www.verizon.com/smartphones/apple-iphone-18-pro/ (seen 2026-09-30; storage steps +$5.55, +$16.66, +$33.33 a month over 36 months)",
  "apple-18pro": "https://www.apple.com/newsroom/2026/09/apple-debuts-iphone-18-pro-and-iphone-18-pro-max/ (iPhone 18 Pro from $1,199, Pro Max from $1,299; no base iPhone 18 this autumn)",
  "apple-duo": "https://www.apple.com/newsroom/2026/09/apple-unveils-iphone-duo/ and https://www.macrumors.com/2026/09/09/iphone-duo-pricing-pre-orders-release-date/ (from $1,999, 512 GB $2,199, 1 TB $2,599, 2 TB $3,199; pre-order 2026-10-16, on sale 2026-10-23)",
  "samsung-s26": "https://www.samsung.com/us/smartphones/galaxy-s26/buy/ and https://www.sammobile.com/news/samsung-galaxy-s26-ultra-price/ (S26 $899.99 / $1,099.99; S26+ $1,099.99 / $1,299.99; S26 Ultra $1,299.99 / $1,499.99 / $1,799.99)",
  "samsung-flip8": "https://www.cnbc.com/2026/07/22/samsung-galaxy-z-fold8-ultra-z-fold8-z-flip8-launch.html and https://www.sammobile.com/news/samsung-galaxy-z-flip-8-everything-to-know/ (Z Flip8 from $1,199.99, 512 GB $1,399.99; on sale 2026-08-05)",
  "google-p11": "https://blog.google/products-and-platforms/devices/pixel/google-pixel-11-pro-xl/ (Pixel 11 $899 / $1,019; Pixel 11 Pro $1,099 / $1,219 / $1,449; on sale 2026-08-20)",
  "realism": "docs/verizon/lanes/L3.md, realism table (verizon.com and the makers’ buy pages, seen 2026-09-30)"
 },
 "financing": {
  "months": 36,
  "apr": 0,
  "rounding": "monthly = retail / 36, truncated to the cent, as carriers display it"
 },
 "tradeInNote": "tradeInUpTo is the new-line and tradeInUpgradeUpTo the upgrade maximum trade-in credit shown on verizon.com on 2026-09-30 (null where none was shown); paid as bill credits over 36 months. Content for the buy box, never decided.",
 "imageNote": "Device images are lane L3’s: /vantage/img/devices/<id>.png is transparent (use it on the light cards; a .webp of the same name is 4–8× lighter, and a .jpg is on white). Provenance is in /vantage/img/MANIFEST.json. A missing file paints /vantage/img/placeholder-device.svg, never a broken tag.",
 "priceBands": {
  "source": "price_usd",
  "cuts": [
   400,
   900
  ],
  "labels": [
   "entry",
   "core",
   "premium"
  ],
  "note": "The registry's own derived dimension (reflex document, priceBand), on full retail. The page never bands anything: the engine derives the band from price_usd on every event and every /sort candidate. A storage step that crosses $900 moves the band."
 },
 "rail": {
  "slot": "phones-rail",
  "take": 6,
  "endpoint": "POST /sort",
  "candidateFields": [
   "id",
   "brand",
   "ecosystem",
   "price_usd"
  ],
  "weights": {
   "affinity": 1,
   "dims": {
    "brand": 1,
    "ecosystem": 0.6,
    "priceBand": 0.8
   }
  },
  "note": "The slots document kind carries no sort dials, so these travel on the request. Send candidates in this file's order; affinity 0 returns exactly this order. /sort answers only once the visitor has a captured event."
 },
