    "decomposition": {
      "status": "partial",
      "criteria": [
        {
          "id": "W09-ENVELOPE-VISIBILITY",
          "description": "Byte-budgeted legacy-compatible full-record queue envelope and producer rejection visibility only; full delivery/recovery/quarantine/DLQ/consumer/fanout/reconciliation/fold obligations remain open."
        },
        {
          "id": "W09-MANAGED-RECOVERY",
          "description": "Managed retry-safe canonical persistence/shared fallback plus conditional erasure containment only; full recovery/DLQ/quarantine/completeness/fanout/fold and erasure fence remain open."
        },
        {
          "id": "W09-CONSUMER-DISPOSITION",
          "description": "Whole-envelope validation and per-message queue dispositions only; durable quarantine/DLQ/exhaustion recovery and fan-out/logical reconciliation remain open."
        },
        {
          "id": "W09-FAN-ACK",
          "description": "Downstream handler acknowledgement and actual caller visibility only; durable logical-event reconciliation/recovery remain open."
        },
        {
          "id": "W09-LOGICAL-IDENTITY",
          "description": "Collision-resistant producer identity and exact replay only; sink idempotency, reconciliation and recovery remain open."
        },
        {
          "id": "W09-DLQ-ROUTING",
          "description": "Isolated per-environment declarations and representative local full-body retry-exhaustion forwarding only; activation, finite retention/durability, operational recovery and complete parent delivery guarantees remain open."
        },
        {
          "id": "W09-DELIVERY-ISOLATION",
          "description": "Per-input managed completion and disjoint delivery/key failure isolation, independent legacy persistence only; same-key/legacy partial retries and full recovery/completeness remain open."
        }
      ],
