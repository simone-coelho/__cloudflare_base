  "design": {
    "context": "Validate channel vocabulary and host, preserve an established visit entry channel, classify Meta cpc as paid_social, keep partial/invalid input unknown, apply read-time idle rollover, and make SDK cache/entry context visit-aware on both hosts.",
    "seed": "Add explicit versioned per-slot context-to-canonical-tag seed configuration applied at gamma zero before learned lift. It is distinct from learned weighting and cannot invent a score floor.",
    "journey": "Use versioned thresholds and a shared stage vocabulary; store visit-local counters separately from cumulative durable taste. Reset the current journey on a new visit and after purchase without deleting valid longer-lived affinity.",
    "continuity": "Use existing ShopperReflex as the serialized owner of a separate purpose-bound rotating proof. Bind tenant, physical owner/subject, session, epoch, generation, original fixed expiry, current consent and explicit covered-purpose policy. Atomic consume/rotate returns a fresh normal ss1 plus remaining fixed proof lifetime and permits one exact lost-response retry only. Retire on logout, detach, reset, link and erase. Direct storage and HttpOnly broker modes stay disabled/fail closed unless a published finite mode/window and W06 purpose-specific retention approval exist. Do not put the long proof in HTML, event bodies, logs, URLs or ordinary SDK envelopes.",
    "scenarios": "Use actual Coach Handbags, Small Leather Goods and Accessories taxonomy and real event shapes, including unknown and cross-category cases, sparse first/third interaction, new visit/post-purchase reset, and day7/day14 restarts with no intervening lifetime renewal. Prove wrong purpose/tenant/owner/generation, predecessor reuse, concurrency, lost response, policy/consent/erase expiry and alarm cleanup refusal.",
    "zero_base": "Compute contextual influence from the final pre-lift base after merchandising. Exact zero stays zero and receipts cannot claim multiplicative learned influence that did not affect ranking."
  },
  "acceptance": [
    "C1 complete original W16/F13/F14/N15/N20/customer152 scope and live boundary preserved.",
    "C2 validated visit/channel through both hosts/read-time/SDK; no invented direct/first, spoofed host, stale channel or Meta misclassification.",
    "C3 explicit versioned per-slot canonical contextual seeds operate at gamma zero and fail closed.",
    "C4 versioned visit-local journey thresholds/reset are separate from cumulative durable taste and historical replay.",
    "C5 shared stage/context vocabulary across owner/session/projection/LearnStats/buffered/ODP/content.",
    "C6 bounded rotating anonymous continuity proof with fixed lifetime, exact retry and lifecycle retirement; disabled/fail closed absent explicit policy.",
    "C7 honest final-prelift exact-zero influence; no global floor or W25/W32 redesign.",
    "C8 actual Coach taxonomy/events, unknown, cross-category, sparse and day/week restart scenarios.",
    "C9 exact 59-file containment, focused checks, generated SDK custody and distinct frozen review.",
    "C10 live customer/feed/calibration/privacy/duration/browser/deployed/SLO/quality/business acceptance remains OPEN."
  ],
